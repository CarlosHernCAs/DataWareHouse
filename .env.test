# ==============================================================================
# ACP Platform - Entorno de Pruebas E2E (Full Stack)
# ==============================================================================
# Este archivo es utilizado automáticamente por Playwright (global.setup.ts).

ACP_ENTORNO=dev

# ── BASE DE DATOS DE PRUEBAS (SQL Server) ─────────────────────────────────────
# [!] IMPORTANTE: Esta base de datos SERÁ BORRADA Y RECREADA POR EL ETL
# durante las pruebas. JAMÁS usar la de producción ni desarrollo aquí.
DB_SERVIDOR=LCP-PAG-PRACTIC
DB_NOMBRE=ACP_DataWarehouse_Test
DB_USUARIO=
DB_CLAVE=
DB_DRIVER=ODBC Driver 17 for SQL Server

# ── SEGURIDAD (JWT) ───────────────────────────────────────────────────────────
ACP_JWT_SECRETO=SECRETO_DE_PRUEBA_MUY_LARGO_Y_SEGURO_PARA_E2E

# ── CONFIGURACIÓN DE RED ──────────────────────────────────────────────────────
ACP_HOST=0.0.0.0
ACP_PUERTO=8810

# ── CORS ──────────────────────────────────────────────────────────────────────
ACP_CORS_ORIGENES=["http://localhost:3000"]
