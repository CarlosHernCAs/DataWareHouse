# .understandignore — patrones a excluir del análisis
# Sintaxis: igual a .gitignore (globs, # comentarios, ! negación, / final para dirs)
#
# Built-in defaults (siempre excluidos a menos que negados):
#   node_modules/, .git/, dist/, build/, .next/, out/, coverage/, *.lock, *.min.js, etc.

# --- Detected directories ---
e2e/
tests/
test-results/
playwright-report/

# --- Scan local meta (queremos auditar el portal Next.js, no archivos de tooling) ---
.codegraph/
.understand-anything/
.cursor/

# --- Plan/review docs (excluidos del scan; son docs externos al code) ---
# Context.md
# CLAUDE.md
# REVIEW-PAGINA-UPDATE.md
# PAGINA UPDATE.md
# MEJORAS.md

# --- Test files patterns ---
*.test.*
*.spec.*
*.snap
